/target
.venv/
__pycache__/

# artefatti delle misure (enormi): model+hub ~4,6 GB, hess ~3,9 GB, ~2,5 GB per run
/models/
/data/
/runs/*
!/runs/*.md
*.safetensors
# fixture della suite toy: Hessiani sintetici da ~3 KB a ~2 MB, committati per far girare i test senza download
!tests/fixtures/**/*.safetensors
*.bin
*.log

# binari compilati a mano: ora li produce il workflow .github/workflows/release.yml su tag v* e li allega
# alla GitHub Release; un commit da 8,6 MB non è versionabile e diventa obsoleto al primo rebuild
/dist/
